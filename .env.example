# GlowCart environment variables — copy to .env.local and fill in.
# Get a key from the YouCam API console: https://yce.makeupar.com/api-console/en/api-keys/

# Perfect Corp YouCam API key (server-side only, sent as a Bearer token).
# Leave empty to run in DEMO MODE: the full scan flow works end-to-end with
# a realistic sample result, clearly labeled "Demo result" in the UI.
YOUCAM_API_KEY=

# Optional: override the YouCam API base URL (defaults to the production host).
# YOUCAM_API_BASE_URL=https://yce-api-01.makeupar.com
